<!DOCTYPE html>
<html lang="ru">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>AxisAura Lab — Выпуск четвёртый</title>
    <link href="https://fonts.googleapis.com/css2?family=Caveat:wght@700&display=swap" rel="stylesheet">
    <style>
        * { margin: 0; padding: 0; box-sizing: border-box; }

        body {
            background-color: #000000;
            color: #ffffff;
            font-family: Arial, sans-serif;
            min-height: 100vh;
            padding: 80px 30px;
            display: flex;
            flex-direction: column;
            align-items: center;
            text-align: center;
        }

        h1 {
            font-family: 'Caveat', cursive;
            font-size: 56px;
            font-weight: 700;
            color: #d4af37;
            transform: rotate(-3deg);
            margin-bottom: 15px;
            opacity: 0;
            transition: opacity 0.5s ease;
        }

        h1.visible { opacity: 1; }

        .topic {
            font-family: 'Caveat', cursive;
            font-size: 40px;
            font-weight: 700;
            color: #d4af37;
            margin-bottom: 50px;
            opacity: 0;
            transition: opacity 0.5s ease;
        }

        .topic.visible { opacity: 1; }

        .typed {
            font-size: 18px;
            line-height: 1.8;
            max-width: 700px;
            margin-bottom: 25px;
            color: #ffffff;
            min-height: 30px;
            text-align: center;
        }

        .cursor {
            display: inline-block;
            width: 2px;
            height: 20px;
            background-color: #d4af37;
            vertical-align: middle;
            animation: blink 1s infinite;
            margin-left: 2px;
        }

        @keyframes blink {
            0%, 50% { opacity: 1; }
            51%, 100% { opacity: 0; }
        }

        .smiley {
            font-family: 'Caveat', cursive;
            font-size: 56px;
            font-weight: 700;
            color: #d4af37;
            margin: 50px 0 20px 0;
            min-height: 70px;
            letter-spacing: 2px;
        }

        .signature {
            font-family: 'Caveat', cursive;
            font-size: 48px;
            font-weight: 700;
            color: #d4af37;
            transform: rotate(-4deg);
            margin: 20px 0 60px 0;
            letter-spacing: 18px;
            opacity: 0;
            transition: opacity 1s ease;
        }

        .signature.visible { opacity: 1; }

        .quote {
            font-family: 'Caveat', cursive;
            font-size: 26px;
            color: #ffffff;
            max-width: 800px;
            line-height: 1.6;
            margin-bottom: 20px;
            opacity: 0;
            transition: opacity 1.5s ease;
            position: relative;
        }

        .quote.visible { opacity: 1; }

        .quote::before {
            content: "“";
            font-size: 50px;
            vertical-align: middle;
            margin-right: 10px;
            opacity: 0.8;
        }

        .quote-author {
            font-family: 'Caveat', cursive;
            font-size: 28px;
            color: #d4af37;
            font-weight: 700;
            margin-bottom: 50px;
            opacity: 0;
            transition: opacity 1.5s ease;
        }

        .quote-author.visible { opacity: 1; }

        .icons-row {
            display: flex;
            justify-content: center;
            align-items: center;
            gap: 40px;
            margin-bottom: 60px;
            flex-wrap: wrap;
        }

        .icon-svg {
            width: 90px;
            height: 90px;
            opacity: 0;
            transform: scale(0.7);
            transition: opacity 0.8s ease, transform 0.8s ease;
        }

        .icon-svg.visible {
            opacity: 1;
            transform: scale(1);
        }

        .icon-svg path,
        .icon-svg rect,
        .icon-svg circle,
        .icon-svg line,
        .icon-svg polyline,
        .icon-svg polygon {
            stroke: #d4af37;
            stroke-width: 4;
            fill: none;
            stroke-linecap: round;
            stroke-linejoin: round;
        }

        .back {
            font-family: 'Caveat', cursive;
            font-size: 28px;
            font-weight: 700;
            color: #d4af37;
            text-decoration: none;
            opacity: 0;
            transition: opacity 1s ease, color 0.3s ease;
            display: inline-flex;
            align-items: center;
            gap: 10px;
        }

        .back.visible { opacity: 1; }

        .back:hover { color: #f0c75e; }

        .back .arrow {
            font-size: 34px;
            display: inline-block;
            transform: rotate(-15deg);
        }
    </style>
</head>
<body>

    <h1 id="title">Выпуск четвёртый — 28 января</h1>

    <div class="topic" id="topic">Тема: Структурная криптография</div>

    <div class="typed" id="typed1"></div>
    <div class="typed" id="typed2"></div>
    <div class="typed" id="typed3"></div>
    <div class="typed" id="typed4"></div>
    <div class="typed" id="typed5"></div>
    <div class="typed" id="typed6"></div>
    <div class="typed" id="typed7"></div>

    <div class="smiley" id="smiley"></div>

    <div class="signature" id="signature">X X X X</div>

    <div class="quote" id="quote">Проблема криптографии — сделать сообщение непонятным для врага, но понятным для получателя.</div>

    <div class="quote-author" id="quoteAuthor">Клод Шеннон</div>

    <div class="icons-row">

        <svg class="icon-svg" id="icon1" viewBox="0 0 100 100">
            <rect x="15" y="35" width="70" height="45" rx="5"/>
            <line x1="25" y1="50" x2="75" y2="50"/>
            <line x1="25" y1="60" x2="75" y2="60"/>
            <line x1="25" y1="70" x2="75" y2="70"/>
            <rect x="25" y="20" width="50" height="15" rx="3"/>
        </svg>

        <svg class="icon-svg" id="icon2" viewBox="0 0 100 100">
            <rect x="15" y="15" width="70" height="70" rx="8"/>
            <circle cx="50" cy="50" r="14"/>
            <line x1="50" y1="36" x2="50" y2="30"/>
            <line x1="50" y1="64" x2="50" y2="70"/>
            <line x1="36" y1="50" x2="30" y2="50"/>
            <line x1="64" y1="50" x2="70" y2="50"/>
        </svg>

        <svg class="icon-svg" id="icon3" viewBox="0 0 100 100">
            <polygon points="50,15 85,30 85,55 50,85 15,55 15,30"/>
            <line x1="50" y1="35" x2="50" y2="60"/>
            <circle cx="50" cy="68" r="3"/>
        </svg>

    </div>

    <a href="index.html" class="back" id="back">
        <span class="arrow">←</span>
        <span>На главную</span>
    </a>

    <script>
        const PRINT_SPEED = 30;
        const ERASE_SPEED = 25;
        const PAUSE_BEFORE_ERASE = 700;
        const PAUSE_BEFORE_NEW = 350;
        const PAUSE_AFTER_LINE = 250;

        function sleep(ms) {
            return new Promise(resolve => setTimeout(resolve, ms));
        }

        async function typeText(element, segments) {
            let html = '';
            for (let i = 0; i < segments.length; i++) {
                const seg = segments[i];

                if (seg.type === 'text') {
                    for (const char of seg.value) {
                        html += char;
                        element.innerHTML = html + '<span class="cursor"></span>';
                        await sleep(PRINT_SPEED);
                    }
                } else if (seg.type === 'rewrite') {
                    for (const char of seg.old) {
                        html += char;
                        element.innerHTML = html + '<span class="cursor"></span>';
                        await sleep(PRINT_SPEED);
                    }
                    await sleep(PAUSE_BEFORE_ERASE);
                    for (let j = 0; j < seg.old.length; j++) {
                        html = html.slice(0, -1);
                        element.innerHTML = html + '<span class="cursor"></span>';
                        await sleep(ERASE_SPEED);
                    }
                    await sleep(PAUSE_BEFORE_NEW);
                    for (const char of seg.new) {
                        html += char;
                        element.innerHTML = html + '<span class="cursor"></span>';
                        await sleep(PRINT_SPEED);
                    }
                }
            }
            element.innerHTML = html;
        }

        async function smileyAnimation() {
            const el = document.getElementById('smiley');
            const frames = [':-)', ';-)', ':-)'];

            for (let i = 0; i < frames.length; i++) {
                const frame = frames[i];
                for (const char of frame) {
                    el.innerHTML += char;
                    await sleep(70);
                }
                if (i < frames.length - 1) {
                    await sleep(500);
                    for (let j = 0; j < frame.length; j++) {
                        el.innerHTML = el.innerHTML.slice(0, -1);
                        await sleep(45);
                    }
                    await sleep(250);
                }
            }
        }

        async function startTyping() {
            await sleep(500);
            document.getElementById('title').classList.add('visible');
            await sleep(500);
            document.getElementById('topic').classList.add('visible');
            await sleep(500);

            await typeText(document.getElementById('typed1'), [
                { type: 'text', value: 'Шифрование, заложенное в саму ' },
                { type: 'rewrite', old: 'геометрию', new: 'структуру' },
                { type: 'text', value: ' таблицы.' }
            ]);
            await sleep(PAUSE_AFTER_LINE);

            await typeText(document.getElementById('typed2'), [
                { type: 'rewrite', old: 'Ноль', new: 'Ни одного' },
                { type: 'text', value: ' вычислений.' }
            ]);
            await sleep(PAUSE_AFTER_LINE);

            await typeText(document.getElementById('typed3'), [
                { type: 'rewrite', old: 'Абсолютная', new: 'Полная' },
                { type: 'text', value: ' защита. С примерами и сравнением с ' },
                { type: 'rewrite', old: 'классическими', new: 'старыми' },
                { type: 'text', value: ' алгоритмами.' }
            ]);
            await sleep(PAUSE_AFTER_LINE);

            await typeText(document.getElementById('typed4'), [
                { type: 'text', value: 'Мы не даём готовых решений. Мы ищем их вместе с вами.' }
            ]);
            await sleep(PAUSE_AFTER_LINE);

            await typeText(document.getElementById('typed5'), [
                { type: 'text', value: 'Мы строим новый метод передачи данных — с нуля, без бюджетов, без корпораций. На строгой математике, честных ' },
                { type: 'rewrite', old: 'прототипах', new: 'испытаниях' },
                { type: 'text', value: ' и пространственно четырёхосевой архитектуре.' }
            ]);
            await sleep(PAUSE_AFTER_LINE);

            await typeText(document.getElementById('typed6'), [
                { type: 'text', value: 'Если ты инженер, физик, программист, математик — напиши нам. Если ты студент и хочешь попробовать себя в реальном проекте — напиши нам. Если ты просто хочешь помочь — напиши нам.' }
            ]);
            await sleep(PAUSE_AFTER_LINE);

            await typeText(document.getElementById('typed7'), [
                { type: 'text', value: 'Мы не обещаем готовый продукт. Мы строим его вместе. Вместе мы творим историю, за которую будет не стыдно перед будущим поколением. Каждый из вас уже творец от рождения. Раскройте свои таланты.' }
            ]);

            await sleep(600);
            await smileyAnimation();
            await sleep(600);
            document.getElementById('signature').classList.add('visible');
            await sleep(600);
            document.getElementById('quote').classList.add('visible');
            await sleep(1000);
            document.getElementById('quoteAuthor').classList.add('visible');
            await sleep(600);
            document.getElementById('icon1').classList.add('visible');
            await sleep(400);
            document.getElementById('icon2').classList.add('visible');
            await sleep(400);
            document.getElementById('icon3').classList.add('visible');
            await sleep(600);
            document.getElementById('back').classList.add('visible');
        }

        startTyping();
    </script>

</body>
</html>
